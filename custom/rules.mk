# custom/rules.mk: feature switches, included at the end of Oryx's rules.mk.
# Later assignments win, so you can override what Oryx sets. Examples:

# COMBO_ENABLE = yes
# KEY_OVERRIDE_ENABLE = yes
# REPEAT_KEY_ENABLE = yes

# Extra C files live next to this one; list them relative to the keymap folder:
# SRC += custom/features/my_feature.c
